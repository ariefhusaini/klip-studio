# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
# Transcription provider: openai (Whisper) or deepgram
TRANSCRIBE_PROVIDER=openai
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
# Model that picks highlights
CLAUDE_MODEL=claude-opus-5-5
# Set to 1 to run the whole pipeline without any API keys (fake transcript + evenly spaced clips)
MOCK_AI=0
DATA_DIR=./data
